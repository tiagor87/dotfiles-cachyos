# config — Ghostty (CachyOS / niri)
#
# Linkado para ~/.config/ghostty/config pelo terminal/install/2-symlinks.sh.
# Espelha a fonte, o tema e os atalhos de panes do terminal/wezterm/wezterm.lua;
# as abas ficam com os defaults do Ghostty.

# ─── Fonte ───────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 11.5
# line_height = 1.1 do WezTerm: célula 10% mais alta que o padrão da fonte.
adjust-cell-height = 10%

# ─── Cores ───────────────────────────────────────────────────────────────────
# 1) fallback estático bonito (Catppuccin Mocha, embutido no Ghostty)...
theme = Catppuccin Mocha
# 2) ...sobrescrito pelas cores dinâmicas do DMS quando presentes (Material You).
#    O template matugen do DMS (matugenTemplateGhostty) grava o arquivo abaixo;
#    o "?" faz o Ghostty ignorar o include enquanto ele não existir.
config-file = ?themes/dankcolors

# Mesma transparência do WezTerm (window_background_opacity = 0.92).
background-opacity = 0.92

# ─── Panes (splits) ──────────────────────────────────────────────────────────
# Sem isso valem os defaults do Ghostty (ctrl+shift+o à direita, ctrl+shift+e
# abaixo); aqui os splits usam as mesmas teclas do wezterm.lua.
# O "\" vai nas duas grafias (caractere e nome da tecla) porque o Ghostty trata
# as duas como gatilhos distintos; como apontam pra mesma ação, tanto faz qual
# dispara no layout us-intl.
keybind = ctrl+\=new_split:right
keybind = ctrl+backslash=new_split:right
keybind = ctrl+-=new_split:down

# Navegação entre panes (hjkl + setas).
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down

keybind = ctrl+shift+z=toggle_split_zoom
# O equalize do WezTerm é um script (equalize.js); no Ghostty é ação nativa.
keybind = ctrl+shift+e=equalize_splits

# Fechar: ctrl+shift+w fecha o pane (default do Ghostty é fechar a aba) e
# ctrl+w fecha a aba, como no WezTerm.
keybind = ctrl+shift+w=close_surface
keybind = ctrl+w=close_tab:this

# ctrl+- virou split, então o diminuir fonte vai pro ctrl+shift+- (mesmo lugar
# do WezTerm). Os dois usam o caractere "-", e não o nome "minus": são gatilhos
# diferentes pro Ghostty, e só o caractere sobrescreve o default.
keybind = ctrl+shift+-=decrease_font_size:1
