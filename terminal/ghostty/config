# config — Ghostty (CachyOS / niri)
#
# Linkado para ~/.config/ghostty/config pelo terminal/install/2-symlinks.sh.
# Define só fonte, tema e transparência: o TECLADO fica nos defaults do Ghostty.
# Os panes/splits do dia a dia são do herdr (prefix ctrl+b), que roda dentro do
# terminal — não remapeamos nada aqui pra não colidir com ele.

# ─── Fonte ───────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 11.5
# Célula 10% mais alta que o padrão da fonte (equivale a um line-height 1.1).
adjust-cell-height = 10%

# ─── Cores ───────────────────────────────────────────────────────────────────
# 1) fallback estático bonito (Catppuccin Mocha, embutido no Ghostty)...
theme = Catppuccin Mocha
# 2) ...sobrescrito pelas cores dinâmicas do DMS quando presentes (Material You).
#    O template matugen do DMS (matugenTemplateGhostty) grava o arquivo abaixo;
#    o "?" faz o Ghostty ignorar o include enquanto ele não existir.
config-file = ?themes/dankcolors

# ─── Janela ──────────────────────────────────────────────────────────────────
# Sem titlebar/borda do GTK: o niri já é tiling e desenha as próprias bordas.
window-decoration = none

# Janela levemente transparente (deixa o wallpaper aparecer por baixo).
background-opacity = 0.92

# ─── Teclado ─────────────────────────────────────────────────────────────────
# Nenhum `keybind` aqui, de propósito: valem os defaults do Ghostty. Para ver os
# que estão ativos:  ghostty +list-keybinds
